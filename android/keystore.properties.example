# Copy to keystore.properties (which git ignores) to sign release builds.
# Create the key once with:
#   keytool -genkeypair -v -keystore release.jks -alias release -keyalg RSA -keysize 4096 -validity 10000
# Keep release.jks and its passwords safe: every future update must be signed with the same key.
storeFile=release.jks
storePassword=
keyAlias=release
keyPassword=
