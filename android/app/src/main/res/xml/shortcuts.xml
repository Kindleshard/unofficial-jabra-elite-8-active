<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: switch the sound mode without opening the app. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="anc"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_anc"
        android:shortcutShortLabel="@string/shortcut_anc"
        android:shortcutLongLabel="@string/shortcut_anc_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.kindleshard.elite8active.shortcuts.ModeShortcutActivity"
            android:targetPackage="io.github.kindleshard.elite8active">
            <extra
                android:name="mode"
                android:value="ANC" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="hearthrough"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_hearthrough"
        android:shortcutShortLabel="@string/shortcut_hearthrough"
        android:shortcutLongLabel="@string/shortcut_hearthrough_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.kindleshard.elite8active.shortcuts.ModeShortcutActivity"
            android:targetPackage="io.github.kindleshard.elite8active">
            <extra
                android:name="mode"
                android:value="HEAR_THROUGH" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="off"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_off"
        android:shortcutShortLabel="@string/shortcut_off"
        android:shortcutLongLabel="@string/shortcut_off_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.kindleshard.elite8active.shortcuts.ModeShortcutActivity"
            android:targetPackage="io.github.kindleshard.elite8active">
            <extra
                android:name="mode"
                android:value="OFF" />
        </intent>
    </shortcut>
</shortcuts>
