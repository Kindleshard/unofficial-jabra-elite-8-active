<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Elite8Active.Tray</RootNamespace>
    <AssemblyName>Elite8Active</AssemblyName>
    <Product>Unofficial Jabra Elite 8 Active</Product>
    <AssemblyTitle>Unofficial Jabra Elite 8 Active</AssemblyTitle>
    <Version>0.2.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn from the artwork by the app's own make-icon switch (see DevTools.cs). -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WFO0003: the DPI setting stays in the manifest, because WPF reads it from there. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Release downloads: one .exe with .NET inside, so nothing has to be installed first. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms' names clash with WPF's (Application, Button, Color…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elite8Active.Core\Elite8Active.Core.csproj" />
  </ItemGroup>

</Project>
